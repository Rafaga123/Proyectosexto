	btnDown: { name: default-round-down, color: { r: 0.3, g: 0.5, b: 0.8, a: 1 } },
	overlay: { name: white, color: { r: 0, g: 0, b: 0, a: 0.75 } }
},
ButtonStyle: {
	default: { down: btnDown, up: btnUp, disabled: default-round },
