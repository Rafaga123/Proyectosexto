{
BitmapFont: { default-font: { file: default.fnt } },
Color: {
	green: { a: 1, b: 0, g: 1, r: 0 },
	white: { a: 1, b: 1, g: 1, r: 1 },
	red: { a: 1, b: 0, g: 0, r: 1 },
	black: { a: 1, b: 0, g: 0, r: 0 },
	gray: { a: 1, b: 0.6, g: 0.6, r: 0.6 },
	gold: { a: 1, b: 0.1, g: 0.84, r: 1.0 },
	darkBg: { a: 1, b: 0.1, g: 0.1, r: 0.12 },
	accent: { a: 1, b: 0.5, g: 0.7, r: 0.25 }
},
TintedDrawable: {
